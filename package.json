{
	"name": "@oomfware/cgr",
	"version": "0.2.1",
	"description": "ask questions about git repositories using Claude Code",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "https://codeberg.org/oomfware/cgr"
	},
	"bin": {
		"cgr": "./dist/index.mjs"
	},
	"files": [
		"dist/",
		"src/",
		"!src/**/*.bench.ts",
		"!src/**/*.test.ts"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@inquirer/checkbox": "^5.1.0",
		"@inquirer/confirm": "^6.0.8",
		"@optique/core": "^0.10.6",
		"@optique/run": "^0.10.6",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@types/node": "^25.3.0",
		"bumpp": "^10.4.1",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3"
	}
}
