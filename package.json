{
	"name": "@oomfware/cgr",
	"version": "0.1.3",
	"description": "ask questions about git repositories using Claude Code",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "https://codeberg.org/oomfware/cgr"
	},
	"bin": {
		"cgr": "./dist/index.mjs"
	},
	"files": [
		"dist/",
		"src/",
		"!src/**/*.bench.ts",
		"!src/**/*.test.ts"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@inquirer/checkbox": "5.0.4",
		"@inquirer/confirm": "6.0.4",
		"@optique/core": "^0.9.1",
		"@optique/run": "^0.9.1"
	},
	"devDependencies": {
		"@types/node": "^25.0.10",
		"bumpp": "^10.4.0",
		"oxfmt": "^0.26.0",
		"oxlint": "^1.41.0",
		"tsdown": "^0.19.0",
		"typescript": "^5.9.3"
	}
}
